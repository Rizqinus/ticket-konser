PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# Supabase PostgreSQL Configuration
SUPABASE_HOST=aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=postgres.your_project_ref
SUPABASE_PASSWORD=your_supabase_database_password
SUPABASE_DATABASE=postgres
SUPABASE_URL=postgresql://postgres.your_project_ref:your_supabase_database_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
